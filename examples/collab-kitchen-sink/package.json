{
	"name": "@plim/example-collab-kitchen-sink",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently -k -n server,web -c green,cyan \"tsx watch server/index.ts\" \"vite\"",
		"dev:server": "tsx watch server/index.ts",
		"dev:web": "vite",
		"build": "pnpm -w -r --filter=\"@plim/*\" --filter=\"!@plim/example-*\" build && vite build",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
		"preview": "vite preview --port 4176"
	},
	"dependencies": {
		"@plim/core": "workspace:*",
		"@plim/editor": "workspace:*",
		"@plim/react": "workspace:*",
		"hono": "^4.12.25",
		"react": "^18.3.0",
		"react-dom": "^18.3.0"
	},
	"devDependencies": {
		"@hono/node-server": "^2.0.5",
		"@types/node": "^22.10.0",
		"@types/react": "^18.3.0",
		"@types/react-dom": "^18.3.0",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^4.3.0",
		"concurrently": "^10.0.3",
		"tsx": "^4.22.4",
		"typescript": "^5.7.3",
		"vite": "^5.4.0",
		"ws": "^8.21.0"
	}
}
