{
  "name": "plim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:example": "pnpm --filter @plim/example-basic-editor build",
    "build:example:react-tailwind": "pnpm --filter @plim/example-react-tailwind-editor build",
    "dev:example": "pnpm --filter @plim/example-basic-editor dev",
    "dev:example:react-tailwind": "pnpm --filter @plim/example-react-tailwind-editor dev",
    "typecheck": "tsc -b --pretty false",
    "typecheck:example": "pnpm --filter @plim/example-basic-editor typecheck",
    "typecheck:example:react-tailwind": "pnpm --filter @plim/example-react-tailwind-editor typecheck",
    "test": "vitest run",
    "test:example:browser": "pnpm --filter @plim/example-basic-editor test:browser",
    "test:example:react-browser": "pnpm --filter @plim/example-react-tailwind-editor test:browser"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/bun": "^1.3.13",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
	"bun": "^1.3.13"
  },
  "dependencies": {
    "@catmint-fs/core": "0.0.0-prealpha.0",
    "@flue/cli": "^0.3.6",
    "@flue/sdk": "^0.3.6",
    "@playwright/cli": "^0.1.11",
    "just-bash": "^2.14.4",
    "valibot": "^1.3.1"
  }
}
