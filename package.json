{
  "name": "plim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:notion": "pnpm --filter @plim/example-notion-clone dev",
    "build:notion": "pnpm --filter @plim/example-notion-clone build"
  },
  "devDependencies": {
    "@vitest/ui": "^4.1.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
