{
  "name": "@plim/editor",
  "version": "0.1.3",
  "description": "Plim editor: the view layer that mounts a Plim document into a contenteditable, with paste handling, selection, drag-and-drop, and the floating toolbar.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "import": "./dist/styles.css"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Daryl Cecile <darylcecile@gmail.com>",
  "homepage": "https://github.com/darylcecile/plim#readme",
  "bugs": {
    "url": "https://github.com/darylcecile/plim/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darylcecile/plim.git",
    "directory": "packages/editor"
  },
  "keywords": [
    "plim",
    "editor",
    "block-editor",
    "rich-text",
    "wysiwyg",
    "notion",
    "contenteditable"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@darylcecile/sanitizer": "^0.0.2",
    "@plim/core": "workspace:*",
    "@plim/markdown": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b && cp src/styles.css dist/styles.css",
    "typecheck": "tsc -b --pretty false",
    "prepublishOnly": "pnpm build"
  }
}
