{
  "name": "@plim/ledger",
  "version": "0.1.0",
  "description": "Plim ledger: record, replay, merge, diff, conflict resolution, and OT rebase of Plim transactions for bring-your-own sync/CRDT engines.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Daryl Cecile <darylcecile@gmail.com>",
  "homepage": "https://github.com/darylcecile/plim#readme",
  "bugs": {
    "url": "https://github.com/darylcecile/plim/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darylcecile/plim.git",
    "directory": "packages/ledger"
  },
  "keywords": [
    "plim",
    "editor",
    "block-editor",
    "transaction",
    "ledger",
    "crdt",
    "ot",
    "sync"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@plim/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "prepublishOnly": "pnpm build"
  }
}
