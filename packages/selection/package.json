{
  "name": "@plim/selection",
  "version": "0.0.0",
  "description": "Browser-safe Plim selection, drag-and-drop, and layout helpers.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@plim/model": "workspace:*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
