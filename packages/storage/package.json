{
  "name": "@plim/storage",
  "version": "0.3.0",
  "description": "Plim storage: durable persistence primitives for Plim documents — pluggable storage adapters (memory, localStorage, IndexedDB, transport) and debounced snapshot autosave.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Daryl Cecile <darylcecile@gmail.com>",
  "homepage": "https://github.com/darylcecile/plim#readme",
  "bugs": {
    "url": "https://github.com/darylcecile/plim/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darylcecile/plim.git",
    "directory": "packages/storage"
  },
  "keywords": [
    "plim",
    "storage",
    "persistence",
    "autosave",
    "indexeddb",
    "localstorage",
    "block-editor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@plim/core": "workspace:*",
    "@plim/transports": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "prepublishOnly": "pnpm build"
  }
}
